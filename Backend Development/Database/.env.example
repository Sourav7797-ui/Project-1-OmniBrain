# ==========================================
# Application Configuration
# ==========================================
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# ==========================================
# Relational Database (Async PostgreSQL / SQLite)
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omnibrain_db
# SQLite local fallback:
# DATABASE_URL=sqlite+aiosqlite:///./omnibrain.db

# ==========================================
# Qdrant Vector Store Configuration
# ==========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=False

# Collection Names
QDRANT_TEXT_COLLECTION=omnibrain_text
QDRANT_IMAGE_COLLECTION=omnibrain_images

TEXT_VECTOR_SIZE=768
IMAGE_VECTOR_SIZE=512